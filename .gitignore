# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Local-only overrides / secrets — never commit these
*.local
.env
.env.*
!.env.example

# Resolved Impeccable engine — provenance is engine.lock.json, not the binary
.impeccable/

# Python bytecode and test caches
__pycache__/
*.pyc
.pytest_cache/
